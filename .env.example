# Copiați acest fișier în .env și completați valorile. Fișierul .env NU se publică.

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=theater_crawler
DB_USER=odeon_app
DB_PASSWORD=schimbati-aceasta-parola
# folosită doar de docker-compose la crearea containerului
MYSQL_ROOT_PASSWORD=schimbati-si-aceasta-parola
# baza separată folosită de testele automate (creată de teste, dacă utilizatorul are drept)
DB_TEST_NAME=theater_crawler_test

# --- Crawler ---
# pauza minimă (secunde) între două cereri către același site
CRAWLER_REQUEST_DELAY=2.0
CRAWLER_TIMEOUT=20
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_RETRY_AFTER=120
CRAWLER_MAX_CONSECUTIVE_FAILURES=5
# opțional: o adresă de contact adăugată în User-Agent (recomandat în PDF pentru roboți folosiți regulat)
CRAWLER_CONTACT=

# --- Aplicația web ---
WEB_HOST=127.0.0.1
WEB_PORT=5000
FLASK_DEBUG=0
